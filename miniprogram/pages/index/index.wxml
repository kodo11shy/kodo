<!-- 首页 · 一屏完整封面 -->
<view class="page">

  <view class="loading-container" wx:if="{{loading}}"><text>加载中...</text></view>

  <view class="error-container" wx:elif="{{loadError}}">
    <text class="error-icon">😵</text>
    <text class="error-text">加载失败</text>
    <text class="error-desc">请检查网络后重试</text>
    <button class="btn-primary" bindtap="loadHomepage" style="width:auto;padding:20rpx 60rpx;margin-top:30rpx;">重新加载</button>
  </view>

  <!-- ====== 主内容 ====== -->
  <view class="cover" wx:else>

    <!-- ====== 品牌大图（带通知浮标） ====== -->
    <view class="hero">
      <image class="hero-img" src="/images/banner-home-v2.png" mode="aspectFill"></image>
      <view class="hero-shade"></view>

      <!-- 通知 — 浮在图上 -->
      <view class="hero-notice" wx:if="{{latestNotice}}" bindtap="tapNotice" data-id="{{latestNotice.id}}">
        <text class="hn-dot">📢</text>
        <text class="hn-text">{{latestNotice.title}}</text>
      </view>

      <!-- 品牌信息 — 图底部 -->
      <view class="hero-brand">
        <image class="hb-logo" src="/images/logo-small-v2.png" mode="aspectFit"></image>
        <view class="hb-texts">
          <text class="hb-name">{{schoolName}}</text>
          <text class="hb-slogan">{{welcomeMessage}}</text>
        </view>
      </view>
    </view>

    <!-- ====== 快捷栏：联系 + 家长入口 ====== -->
    <view class="quick-bar">
      <view class="qb-item" wx:if="{{contactWechat}}" bindtap="copyWechat">
        <text class="qb-ico">💬</text>
        <text class="qb-txt">微信</text>
      </view>
      <view class="qb-line" wx:if="{{contactWechat && contactPhone}}"></view>
      <view class="qb-item" wx:if="{{contactPhone}}" bindtap="callPhone">
        <text class="qb-ico">📞</text>
        <text class="qb-txt">电话</text>
      </view>
      <view class="qb-line"></view>
      <view class="qb-item qb-parent" bindtap="goParentLogin">
        <text class="qb-ico">👨‍👩‍👧</text>
        <text class="qb-txt">家长入口</text>
        <text class="qb-arr">›</text>
      </view>
    </view>

    <!-- ====== 精彩瞬间（紧凑轮播） ====== -->
    <view class="moments">
      <swiper class="moments-swiper" autoplay interval="3000" duration="500" circular indicator-dots="{{featuredPhotos.length > 1}}">
        <swiper-item wx:for="{{featuredPhotos}}" wx:key="id">
          <view class="mp-item" bindtap="previewPhoto" data-url="{{item.previewUrl}}">
            <image class="mp-img" src="{{item.url}}" mode="aspectFill" lazy-load></image>
          </view>
        </swiper-item>
        <swiper-item wx:if="{{featuredPhotos.length === 0}}">
          <view class="mp-empty"><text>暂无照片</text></view>
        </swiper-item>
      </swiper>
    </view>

    <!-- ====== 关于（一句话） ====== -->
    <view class="about-line">
      <text>🏫 课后陪伴 · 作业辅导 · 餐食照护 · 成长记录</text>
    </view>

    <!-- ====== 老师入口 ====== -->
    <view class="teacher-link" bindtap="goTeacherLogin">
      <text>👩‍🏫 老师登录</text>
    </view>

  </view>

  <!-- 通知弹窗 -->
  <view class="modal-overlay" wx:if="{{showNoticeModal}}" bindtap="closeNotice">
    <view class="notice-modal" catchtap="nop">
      <text class="notice-modal-title">{{selectedNotice.title}}</text>
      <text class="notice-modal-type" wx:if="{{selectedNotice.notice_type}}">{{selectedNotice.notice_type}}</text>
      <view class="notice-modal-divider"></view>
      <scroll-view class="notice-modal-body" scroll-y>
        <text class="notice-modal-content">{{selectedNotice.content}}</text>
      </scroll-view>
      <view class="notice-modal-footer" bindtap="closeNotice">
        <text class="notice-close-btn">知道了</text>
      </view>
    </view>
  </view>

</view>
