/* 首页 · 封面设计版 */
/* 暖杏 · 层次 · 信任感 · 完整信息 */

.page {
  background: #FCF8F3;
  min-height: 100vh;
}

.cover-wrap {
  padding-bottom: 40rpx;
}

/* ====== 1. 品牌区域 ====== */

.brand-zone {
  position: relative;
  height: 380rpx;
  margin: 24rpx 24rpx 0;
  border-radius: 36rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(180, 140, 120, 0.12);
}

.brand-bg {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

.brand-fade {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60%;
  background: linear-gradient(0deg, rgba(74,58,48,0.55) 0%, transparent 100%);
}

.brand-content {
  position: absolute;
  bottom: 30rpx;
  left: 30rpx;
  display: flex;
  flex-direction: column;
}

.brand-logo {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
  background: rgba(255,255,255,0.95);
  padding: 4rpx;
  box-shadow: 0 4rpx 12rpx rgba(74,58,48,0.08);
}

.brand-name {
  font-size: 40rpx;
  font-weight: 800;
  color: #FFFFFF;
  display: block;
  text-shadow: 0 2rpx 12rpx rgba(74,58,48,0.25);
  letter-spacing: 2rpx;
}

.brand-slogan {
  font-size: 24rpx;
  color: rgba(255,255,255,0.80);
  margin-top: 6rpx;
  display: block;
  text-shadow: 0 1rpx 6rpx rgba(74,58,48,0.15);
}

/* 通知浮标 — 右上角 */
.brand-notice {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  right: 20rpx;
  background: rgba(255,255,255,0.90);
  backdrop-filter: blur(8rpx);
  border-radius: 16rpx;
  padding: 14rpx 18rpx;
  font-size: 23rpx;
  color: #4A3A30;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ====== 2. 机构简介 ====== */

.intro-line {
  text-align: center;
  padding: 24rpx 24rpx 0;
  font-size: 24rpx;
  color: #C0B0A0;
  letter-spacing: 2rpx;
}

/* ====== 3. 精彩瞬间 ====== */

.moments-wrap {
  margin: 20rpx 24rpx 0;
}

.moments-head {
  margin-bottom: 12rpx;
}

.moments-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #4A3A30;
}

.moments-scroll {
  display: flex;
  white-space: nowrap;
  overflow-x: auto;
  padding-bottom: 8rpx;
  -webkit-overflow-scrolling: touch;
}

.moments-img {
  width: 240rpx;
  height: 170rpx;
  border-radius: 20rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx rgba(180, 140, 120, 0.06);
}

.moments-img:last-child {
  margin-right: 0;
}

.moments-img:active {
  opacity: 0.8;
}

/* ====== 4. 底部操作区 ====== */

.bottom-zone {
  margin: 24rpx 24rpx 0;
}

/* 联系栏 */

.contact-bar {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 0;
  box-shadow: 0 4rpx 16rpx rgba(180, 140, 120, 0.04);
  overflow: hidden;
}

.ct-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 12rpx;
}

.ct-item:active {
  background: #FCF6F0;
}

.ct-ico {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.ct-val {
  font-size: 24rpx;
  color: #4A3A30;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 35%;
}

.ct-action {
  font-size: 22rpx;
  color: #D4A080;
  font-weight: 600;
  margin-left: 10rpx;
  padding: 4rpx 16rpx;
  border: 2rpx solid #F0DACA;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.ct-call {
  color: #7AB090;
  border-color: #D5E8DE;
}

.ct-divider {
  width: 2rpx;
  height: 40rpx;
  background: #F0E8E0;
  flex-shrink: 0;
}

/* 家长入口按钮 */

.parent-btn {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  margin-top: 16rpx;
  border-radius: 28rpx;
  padding: 28rpx 26rpx;
  box-shadow: 0 4rpx 24rpx rgba(180, 140, 120, 0.08);
}

.parent-btn:active {
  background: #FCF6F0;
}

.pb-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  background: #F5EBE0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.pb-texts {
  flex: 1;
  min-width: 0;
}

.pb-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #4A3A30;
  display: block;
}

.pb-desc {
  font-size: 23rpx;
  color: #C0B0A0;
  margin-top: 4rpx;
  display: block;
}

.pb-arrow {
  font-size: 40rpx;
  color: #D0C8B8;
  flex-shrink: 0;
  margin-left: 10rpx;
}

/* 老师入口 */

.teacher-line {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0 10rpx;
}

.teacher-line:active {
  opacity: 0.6;
}

.tl-ico {
  font-size: 22rpx;
  margin-right: 8rpx;
}

.tl-txt {
  font-size: 24rpx;
  color: #C8B8A8;
}

/* ====== 加载/错误 ====== */

.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  color: #C8B8A8;
  font-size: 28rpx;
}

.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 60rpx;
}

.err-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.err-txt { font-size: 32rpx; color: #B09888; font-weight: 600; }
.err-desc { font-size: 26rpx; color: #C8B8A8; margin-top: 12rpx; }

/* ====== 通知弹窗 ====== */

.notice-modal {
  background: #FFF;
  border-radius: 32rpx;
  width: 86vw;
  max-width: 640rpx;
  max-height: 75vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20rpx 60rpx rgba(74, 58, 48, 0.12);
  overflow: hidden;
  box-sizing: border-box;
}

.notice-modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #4A3A30;
  padding: 36rpx 32rpx 8rpx;
  text-align: center;
  display: block;
}

.notice-modal-type {
  font-size: 22rpx;
  color: #D4A080;
  text-align: center;
  display: block;
  padding: 4rpx 0 12rpx;
}

.notice-modal-divider {
  height: 2rpx;
  background: #F5EDE5;
  margin: 0 32rpx;
}

.notice-modal-body {
  flex: 1;
  padding: 24rpx 32rpx;
  max-height: 50vh;
  overflow-y: auto;
  width: 100%;
  box-sizing: border-box;
}

.notice-modal-content {
  font-size: 28rpx;
  color: #4A3A30;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
  display: block;
  width: 100%;
  box-sizing: border-box;
}

.notice-modal-footer {
  border-top: 2rpx solid #F5EDE5;
  padding: 24rpx 0;
  text-align: center;
}

.notice-close-btn {
  font-size: 28rpx;
  color: #D4A080;
  font-weight: 600;
  padding: 8rpx 48rpx;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(74, 58, 48, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
