/* 首页 · 封面设计版 */
/* 保留原结构 · 暖杏色系 · 层次与细节 */

.page {
  background: #FCF8F3;
  padding-bottom: 40rpx;
  min-height: 100vh;
}

/* ====== 1. 品牌大图 ====== */

.hero {
  margin: 24rpx 24rpx 0;
  height: 380rpx;
  border-radius: 36rpx;
  overflow: hidden;
  position: relative;
  box-shadow: 0 8rpx 32rpx rgba(180, 140, 120, 0.14);
}

.hero-image {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

.hero-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 40rpx 28rpx 28rpx;
  display: flex;
  align-items: center;
  background: linear-gradient(0deg, rgba(74,58,48,0.60) 0%, rgba(74,58,48,0.10) 70%, transparent 100%);
}

.hero-logo {
  width: 68rpx;
  height: 68rpx;
  border-radius: 18rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  background: #FFF;
  padding: 4rpx;
  box-shadow: 0 4rpx 12rpx rgba(74,58,48,0.10);
}

.hero-copy {
  flex: 1;
}

.hero-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #FFFFFF;
  display: block;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 8rpx rgba(74,58,48,0.20);
}

.hero-subtitle {
  font-size: 24rpx;
  color: rgba(255,255,255,0.80);
  margin-top: 6rpx;
  display: block;
  text-shadow: 0 1rpx 4rpx rgba(74,58,48,0.15);
}

/* ====== 通知条 ====== */

.notice-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 22rpx 26rpx;
  box-shadow: 0 4rpx 16rpx rgba(180, 140, 120, 0.04);
  border-left: 8rpx solid #E8C8A0;
  transition: box-shadow 0.2s;
}

.notice-card:active {
  box-shadow: 0 2rpx 8rpx rgba(180, 140, 120, 0.06);
}

.notice-dot {
  font-size: 26rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.notice-text-short {
  flex: 1;
  font-size: 26rpx;
  color: #4A3A30;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notice-more {
  font-size: 23rpx;
  color: #D4A080;
  flex-shrink: 0;
  margin-left: 12rpx;
  font-weight: 500;
  padding: 4rpx 16rpx;
  border: 2rpx solid #F0DACA;
  border-radius: 999rpx;
  line-height: 1.5;
}

/* ====== 联系方式 + 家长入口 ====== */

.contact-section {
  padding: 20rpx 24rpx 0;
}

.contact-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 24rpx rgba(180, 140, 120, 0.06);
}

.contact-row {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx;
  transition: background 0.15s;
}

.contact-row:active {
  background: #FCF6F0;
}

.parent-row {
  background: linear-gradient(135deg, #FAF0E8 0%, #FCF6EE 100%);
}

.parent-row:active {
  background: #F5EBE0;
}

.contact-icon-big {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

/* 每个图标不同底色 */
.contact-row:nth-child(1) .contact-icon-big { background: #F0EBE0; }
.contact-row:nth-child(2) .contact-icon-big { background: #E5EDE5; }
.parent-row .contact-icon-big { background: #F0DACA; }

.contact-info {
  flex: 1;
  min-width: 0;
}

.contact-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #4A3A30;
  display: block;
}

.contact-value {
  font-size: 24rpx;
  color: #B09888;
  margin-top: 4rpx;
  display: block;
}

.contact-desc {
  font-size: 22rpx;
  color: #C0B0A0;
  margin-top: 4rpx;
  display: block;
}

.contact-action {
  font-size: 22rpx;
  color: #D4A080;
  font-weight: 600;
  padding: 8rpx 22rpx;
  border: 2rpx solid #F0DACA;
  border-radius: 999rpx;
  flex-shrink: 0;
  line-height: 1.4;
}

.call-act {
  color: #7AB090;
  border-color: #D5E8DE;
}

.contact-arrow {
  font-size: 40rpx;
  color: #D4A080;
  flex-shrink: 0;
  margin-left: 10rpx;
}

.contact-divider {
  height: 2rpx;
  background: #F0EAE2;
  margin: 0 28rpx;
}

/* ====== 分区标题 ====== */

.section {
  padding: 24rpx 24rpx 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #4A3A30;
  margin-bottom: 16rpx;
  display: block;
}

/* ====== 精彩瞬间 ====== */

.photo-swiper {
  height: 340rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 24rpx rgba(180, 140, 120, 0.06);
}

.photo-item {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #F5EBE0;
}

.photo-img {
  width: 100%;
  display: block;
  min-height: 160rpx;
}

.photo-placeholder {
  display: flex;
  width: 100%;
  height: 100%;
  background: #F5EBE0;
  border-radius: 28rpx;
  justify-content: center;
  align-items: center;
}

.placeholder-text {
  font-size: 24rpx;
  color: #C0A890;
}

.photo-swiper .wx-swiper-dots {
  margin-bottom: 10rpx;
}

.photo-swiper .wx-swiper-dot {
  width: 14rpx;
  height: 6rpx;
  border-radius: 3rpx;
  margin: 0 4rpx;
  background: rgba(255,255,255,0.40);
  transition: width 0.3s;
}

.photo-swiper .wx-swiper-dot-active {
  width: 28rpx;
  background: #FFFFFF;
}

/* ====== 关于托班 ====== */

.about-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 30rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(180, 140, 120, 0.04);
  border-top: 4rpx solid #E8C8A0;
}

.about-card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #4A3A30;
  display: block;
  margin-bottom: 14rpx;
}

.about-card-desc {
  font-size: 26rpx;
  color: #B09888;
  line-height: 1.8;
  display: block;
}

/* ====== 老师入口 ====== */

.teacher-bottom {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx 24rpx 0;
}

.teacher-bottom:active {
  opacity: 0.6;
}

.teacher-bottom-text {
  font-size: 24rpx;
  color: #C8B8A8;
  letter-spacing: 2rpx;
}

/* ====== 底部 ====== */

.footer {
  text-align: center;
  padding: 32rpx 30rpx 10rpx;
}

.footer-text {
  font-size: 20rpx;
  color: #D0C8B8;
}

/* ====== 加载/错误 ====== */

.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 60vh;
  color: #C8B8A8;
  font-size: 28rpx;
}

.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  padding: 60rpx;
}

.error-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.error-text { font-size: 32rpx; color: #B09888; font-weight: 600; }
.error-desc { font-size: 26rpx; color: #C8B8A8; margin-top: 12rpx; }

/* ====== 通知弹窗 ====== */

.notice-modal {
  background: #FFF;
  border-radius: 32rpx;
  width: 86vw;
  max-width: 640rpx;
  max-height: 75vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20rpx 60rpx rgba(74, 58, 48, 0.12);
  overflow: hidden;
  box-sizing: border-box;
}

.notice-modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #4A3A30;
  padding: 36rpx 32rpx 8rpx;
  text-align: center;
  display: block;
}

.notice-modal-type {
  font-size: 22rpx;
  color: #D4A080;
  text-align: center;
  display: block;
  padding: 4rpx 0 12rpx;
}

.notice-modal-divider {
  height: 2rpx;
  background: #F0EAE2;
  margin: 0 32rpx;
}

.notice-modal-body {
  flex: 1;
  padding: 24rpx 32rpx;
  max-height: 50vh;
  overflow-y: auto;
  width: 100%;
  box-sizing: border-box;
}

.notice-modal-content {
  font-size: 28rpx;
  color: #4A3A30;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
  display: block;
  width: 100%;
  box-sizing: border-box;
}

.notice-modal-footer {
  border-top: 2rpx solid #F0EAE2;
  padding: 24rpx 0;
  text-align: center;
}

.notice-close-btn {
  font-size: 28rpx;
  color: #D4A080;
  font-weight: 600;
  padding: 8rpx 48rpx;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(74, 58, 48, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
