/* 首页 · 一屏封面版 */
/* 暖杏色系 · 整屏无滚动 · 所有入口立等可见 */

.page {
  background: #FCF8F3;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.cover {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: calc(100vh - 0rpx);
  padding: 0 0 40rpx;
  box-sizing: border-box;
}

/* ====== 品牌大图 ====== */

.brand-header {
  position: relative;
  height: 320rpx;
  margin: 24rpx 24rpx 0;
  border-radius: 36rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #F0DACA 0%, #E8C8B0 100%);
  flex-shrink: 0;
}

.brand-bg {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

.brand-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 24rpx 24rpx;
  background: linear-gradient(0deg, rgba(74,58,48,0.50) 0%, transparent 100%);
}

.brand-box {
  display: flex;
  align-items: center;
}

.brand-logo {
  width: 60rpx;
  height: 60rpx;
  border-radius: 16rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
  background: rgba(255,255,255,0.9);
  padding: 4rpx;
}

.brand-texts {
  flex: 1;
}

.brand-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFF;
  display: block;
  text-shadow: 0 2rpx 8rpx rgba(74,58,48,0.20);
}

.brand-slogan {
  font-size: 22rpx;
  color: rgba(255,255,255,0.80);
  margin-top: 4rpx;
  display: block;
  text-shadow: 0 1rpx 4rpx rgba(74,58,48,0.15);
}

/* 通知角标 — 右上角小条 */

.brand-notice {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  right: 20rpx;
  background: rgba(255,255,255,0.88);
  backdrop-filter: blur(6rpx);
  border-radius: 16rpx;
  padding: 12rpx 18rpx;
  display: flex;
  align-items: center;
  max-height: 72rpx;
  overflow: hidden;
}

.bn-dot {
  font-size: 22rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.bn-text {
  font-size: 22rpx;
  color: #4A3A30;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ====== 家长入口 ====== */

.parent-entry {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  margin: 24rpx 24rpx 0;
  border-radius: 28rpx;
  padding: 30rpx 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(180, 140, 120, 0.08);
  flex-shrink: 0;
}

.parent-entry:active {
  background: #FCF6F0;
}

.pe-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  background: #F5EBE0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.pe-texts {
  flex: 1;
  min-width: 0;
}

.pe-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #4A3A30;
  display: block;
}

.pe-desc {
  font-size: 24rpx;
  color: #C0B0A0;
  margin-top: 4rpx;
  display: block;
}

.pe-arrow {
  font-size: 40rpx;
  color: #D0C8B8;
  flex-shrink: 0;
  margin-left: 10rpx;
}

/* ====== 联系方式 ====== */

.contact-row {
  display: flex;
  align-items: center;
  margin: 20rpx 24rpx 0;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 0;
  box-shadow: 0 4rpx 16rpx rgba(180, 140, 120, 0.04);
  flex-shrink: 0;
  overflow: hidden;
}

.ct-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 22rpx 16rpx;
}

.ct-item:active {
  background: #FCF6F0;
}

.ct-ico {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.ct-lbl {
  font-size: 22rpx;
  color: #C0B0A0;
  margin-right: 6rpx;
}

.ct-val {
  font-size: 24rpx;
  color: #4A3A30;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 40%;
}

.ct-divider {
  width: 2rpx;
  height: 40rpx;
  background: #F0E8E0;
  flex-shrink: 0;
}

/* ====== 老师入口 ====== */

.teacher-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0 10rpx;
  flex-shrink: 0;
  margin-top: 12rpx;
}

.teacher-entry:active {
  opacity: 0.6;
}

.te-ico {
  font-size: 22rpx;
  margin-right: 8rpx;
}

.te-txt {
  font-size: 24rpx;
  color: #C8B8A8;
}

/* ====== 加载与错误态 ====== */

.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  color: #C8B8A8;
  font-size: 28rpx;
}

.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 60rpx;
}

.err-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.err-txt {
  font-size: 32rpx;
  color: #B09888;
  font-weight: 600;
}

.err-desc {
  font-size: 26rpx;
  color: #C8B8A8;
  margin-top: 12rpx;
}

/* ====== 通知弹窗 ====== */

.notice-modal {
  background: #FFF;
  border-radius: 32rpx;
  width: 86vw;
  max-width: 640rpx;
  max-height: 75vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20rpx 60rpx rgba(74, 58, 48, 0.12);
  overflow: hidden;
  box-sizing: border-box;
}

.notice-modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #4A3A30;
  padding: 36rpx 32rpx 8rpx;
  text-align: center;
  display: block;
}

.notice-modal-type {
  font-size: 22rpx;
  color: #D4A080;
  text-align: center;
  display: block;
  padding: 4rpx 0 12rpx;
}

.notice-modal-divider {
  height: 2rpx;
  background: #F5EDE5;
  margin: 0 32rpx;
}

.notice-modal-body {
  flex: 1;
  padding: 24rpx 32rpx;
  max-height: 50vh;
  overflow-y: auto;
  width: 100%;
  box-sizing: border-box;
}

.notice-modal-content {
  font-size: 28rpx;
  color: #4A3A30;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
  display: block;
  width: 100%;
  box-sizing: border-box;
}

.notice-modal-footer {
  border-top: 2rpx solid #F5EDE5;
  padding: 24rpx 0;
  text-align: center;
}

.notice-close-btn {
  font-size: 28rpx;
  color: #D4A080;
  font-weight: 600;
  padding: 8rpx 48rpx;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(74, 58, 48, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
