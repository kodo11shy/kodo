/* 首页 · 一屏封面 — 通知浮在图上 · 紧凑布局 */

.page {
  background: #FCF8F3;
  min-height: 100vh;
}

.cover {
  display: flex;
  flex-direction: column;
  padding: 0 24rpx 20rpx;
}

/* ====== 1. 品牌大图（带通知浮标） ====== */

.hero {
  position: relative;
  height: 260rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 24rpx rgba(180, 140, 120, 0.12);
  flex-shrink: 0;
  margin-top: 20rpx;
}

.hero-img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

.hero-shade {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 65%;
  background: linear-gradient(0deg, rgba(74,58,48,0.55) 0%, transparent 100%);
}

/* 通知浮标 */
.hero-notice {
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  right: 14rpx;
  background: rgba(255,255,255,0.92);
  backdrop-filter: blur(6rpx);
  border-radius: 14rpx;
  padding: 12rpx 16rpx;
  display: flex;
  align-items: center;
  overflow: hidden;
}

.hn-dot {
  font-size: 22rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.hn-text {
  font-size: 22rpx;
  color: #4A3A30;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}

/* 品牌信息 */
.hero-brand {
  position: absolute;
  bottom: 18rpx;
  left: 20rpx;
  display: flex;
  align-items: center;
}

.hb-logo {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
  background: #FFF;
  padding: 3rpx;
}

.hb-texts {
  flex: 1;
}

.hb-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #FFF;
  display: block;
  text-shadow: 0 2rpx 8rpx rgba(74,58,48,0.20);
  letter-spacing: 1rpx;
}

.hb-slogan {
  font-size: 20rpx;
  color: rgba(255,255,255,0.75);
  margin-top: 2rpx;
  display: block;
}

/* ====== 2. 快捷栏 ====== */

.quick-bar {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 0;
  box-shadow: 0 3rpx 14rpx rgba(180, 140, 120, 0.04);
  flex-shrink: 0;
  margin-top: 16rpx;
  overflow: hidden;
}

.qb-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 22rpx 8rpx;
}

.qb-item:active {
  background: #FCF6F0;
}

.qb-ico {
  font-size: 26rpx;
  margin-right: 8rpx;
}

.qb-txt {
  font-size: 24rpx;
  color: #5A4A40;
  font-weight: 500;
}

.qb-arr {
  font-size: 32rpx;
  color: #D4A080;
  margin-left: 6rpx;
}

.qb-parent .qb-txt {
  color: #C08860;
  font-weight: 600;
}

.qb-line {
  width: 2rpx;
  height: 36rpx;
  background: #F0E8E0;
  flex-shrink: 0;
}

/* ====== 3. 精彩瞬间（紧凑轮播） ====== */

.moments {
  flex-shrink: 0;
  margin-top: 14rpx;
}

.moments-swiper {
  height: 170rpx;
  border-radius: 22rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 18rpx rgba(180, 140, 120, 0.06);
}

.mp-item {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #F5EBE0;
}

.mp-img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

.mp-empty {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5EBE0;
  font-size: 22rpx;
  color: #C0A890;
}

.moments-swiper .wx-swiper-dots {
  margin-bottom: 6rpx;
}

.moments-swiper .wx-swiper-dot {
  width: 12rpx;
  height: 5rpx;
  border-radius: 3rpx;
  margin: 0 3rpx;
  background: rgba(255,255,255,0.40);
}

.moments-swiper .wx-swiper-dot-active {
  width: 22rpx;
  background: #FFFFFF;
}

/* ====== 4. 关于（一句话） ====== */

.about-line {
  flex-shrink: 0;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-top: 12rpx;
  text-align: center;
  font-size: 22rpx;
  color: #B09888;
  letter-spacing: 2rpx;
  box-shadow: 0 2rpx 10rpx rgba(180, 140, 120, 0.03);
}

/* ====== 5. 老师入口 ====== */

.teacher-link {
  flex-shrink: 0;
  text-align: center;
  padding: 20rpx 0 12rpx;
  font-size: 22rpx;
  color: #C8B8A8;
  letter-spacing: 2rpx;
}

.teacher-link:active {
  opacity: 0.6;
}

/* ====== 加载/错误 ====== */

.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  color: #C8B8A8;
  font-size: 28rpx;
}

.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 60rpx;
}

.error-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.error-text { font-size: 32rpx; color: #B09888; font-weight: 600; }
.error-desc { font-size: 26rpx; color: #C8B8A8; margin-top: 12rpx; }

/* ====== 通知弹窗 ====== */

.notice-modal {
  background: #FFF;
  border-radius: 32rpx;
  width: 86vw;
  max-width: 640rpx;
  max-height: 75vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20rpx 60rpx rgba(74, 58, 48, 0.12);
  overflow: hidden;
  box-sizing: border-box;
}

.notice-modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #4A3A30;
  padding: 36rpx 32rpx 8rpx;
  text-align: center;
  display: block;
}

.notice-modal-type {
  font-size: 22rpx;
  color: #D4A080;
  text-align: center;
  display: block;
  padding: 4rpx 0 12rpx;
}

.notice-modal-divider {
  height: 2rpx;
  background: #F0EAE2;
  margin: 0 32rpx;
}

.notice-modal-body {
  flex: 1;
  padding: 24rpx 32rpx;
  max-height: 50vh;
  overflow-y: auto;
  width: 100%;
  box-sizing: border-box;
}

.notice-modal-content {
  font-size: 28rpx;
  color: #4A3A30;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
  display: block;
  width: 100%;
  box-sizing: border-box;
}

.notice-modal-footer {
  border-top: 2rpx solid #F0EAE2;
  padding: 24rpx 0;
  text-align: center;
}

.notice-close-btn {
  font-size: 28rpx;
  color: #D4A080;
  font-weight: 600;
  padding: 8rpx 48rpx;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(74, 58, 48, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
