/* ===== 老师首页 — 沉稳紧凑版 ===== */
/* 深暖灰 + 暖沙色系，全天候不晃眼 */

page, .page {
  min-height: 100vh;
  background: #E8E3DC;
}

/* ===== 顶栏 ===== */

.top-bar {
  background: #4A5550;
  padding: 48rpx 32rpx 28rpx;
}

.top-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.top-greeting {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFF;
  letter-spacing: 1rpx;
}

.top-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFF;
  margin-left: 2rpx;
}

.top-date {
  display: block;
  font-size: 22rpx;
  color: rgba(255,255,255,0.60);
  margin-top: 6rpx;
  font-feature-settings: "tnum";
}

.top-exit {
  font-size: 22rpx;
  color: rgba(255,255,255,0.70);
  padding: 6rpx 20rpx;
  border: 2rpx solid rgba(255,255,255,0.25);
  border-radius: 999rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

/* 错误提示 */

.err-bar {
  background: rgba(215, 180, 100, 0.18);
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
  margin-top: 16rpx;
  font-size: 23rpx;
  color: rgba(255,255,255,0.85);
  text-align: center;
}

/* 出勤面板 */

.stat-panel {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: rgba(255,255,255,0.10);
  border-radius: 16rpx;
  margin-top: 24rpx;
  padding: 22rpx 12rpx;
}

.stat-cell {
  flex: 1;
  text-align: center;
}

.stat-val {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: #FFF;
  line-height: 1.1;
}

.stat-tag {
  display: block;
  font-size: 21rpx;
  color: rgba(255,255,255,0.65);
  margin-top: 6rpx;
  letter-spacing: 1rpx;
}

.stat-highlight {
  color: #D4BA8A;
}

.stat-line {
  width: 2rpx;
  height: 44rpx;
  background: rgba(255,255,255,0.12);
}

/* ===== 功能入口 ===== */

.func-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2rpx;
  background: #E8E3DC;
  padding: 0;
  margin: 0;
}

.func-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 174rpx;
  background: #FFFFFF;
  padding: 18rpx 6rpx;
  position: relative;
  transition: background 0.15s;
}

.func-cell:active {
  background: #F0ECE6;
}

.func-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  margin-bottom: 10rpx;
  background-size: 44rpx 44rpx;
  background-repeat: no-repeat;
  background-position: center;
}

