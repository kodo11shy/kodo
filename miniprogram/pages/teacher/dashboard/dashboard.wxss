/* ===== 老师首页 — 结构化暖杏版 ===== */
/* 色块分区 + 白色工具卡 + 清晰层级 */

page, .page {
  min-height: 100vh;
  background: #FCF8F3;
}

/* ===== 暖色区块 ===== */

.hero-area {
  background: #F0DACA;
  padding: 0 0 36rpx;
  position: relative;
}

/* 底部柔和过渡 */
.hero-area::after {
  content: '';
  position: absolute;
  bottom: -24rpx;
  left: 0;
  right: 0;
  height: 48rpx;
  background: #FCF8F3;
  border-radius: 48rpx 48rpx 0 0;
}

.hero-inner {
  padding: 0 32rpx;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 48rpx;
}

.hero-left {
  display: flex;
  align-items: center;
}

.hero-emoji {
  font-size: 42rpx;
  margin-right: 14rpx;
  line-height: 1;
}

.hero-texts {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
}

.hero-greet {
  font-size: 30rpx;
  font-weight: 500;
  color: rgba(74, 58, 48, 0.65);
}

.hero-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #4A3A30;
  margin-left: 4rpx;
}

.hero-exit {
  font-size: 22rpx;
  color: rgba(74, 58, 48, 0.50);
  padding: 6rpx 22rpx;
  border: 2rpx solid rgba(74, 58, 48, 0.15);
  border-radius: 999rpx;
  flex-shrink: 0;
}

.hero-date {
  font-size: 22rpx;
  color: rgba(74, 58, 48, 0.50);
  margin-top: 6rpx;
  font-feature-settings: "tnum";
  padding-left: 56rpx;
}

.hero-err {
  background: #F5E0C0;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  margin-top: 20rpx;
  font-size: 23rpx;
  color: #B08860;
  text-align: center;
}

/* 出勤简约文字版 */

.hero-stats {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  background: rgba(255,255,255,0.35);
  border-radius: 18rpx;
  padding: 24rpx 28rpx;
  backdrop-filter: blur(4rpx);
}

.hs-unit {
  flex: 1;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.hs-num {
  font-size: 44rpx;
  font-weight: 800;
  color: #4A3A30;
  line-height: 1;
}

.hs-num-muted {
  color: rgba(74, 58, 48, 0.30);
  font-weight: 600;
  font-size: 30rpx;
  margin-left: 4rpx;
}

.hs-unit-sep {
  font-size: 30rpx;
  color: rgba(74, 58, 48, 0.20);
  margin: 0 2rpx;
}

.hs-num-gold {
  color: #C08860;
}

.hs-lbl {
  display: block;
  width: 100%;
  font-size: 21rpx;
  color: rgba(74, 58, 48, 0.55);
  margin-top: 6rpx;
  letter-spacing: 1rpx;
}

.hs-dot {
  width: 6rpx;
  height: 36rpx;
  border-radius: 3rpx;
  background: rgba(255,255,255,0.50);
  margin: 0 20rpx;
  flex-shrink: 0;
}

/* ===== 工具卡片 ===== */

.tools-card {
  margin: -8rpx 24rpx 0;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 8rpx 0;
  box-shadow: 0 4rpx 28rpx rgba(180, 140, 120, 0.08);
  position: relative;
  z-index: 2;
}

.tools-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
}

.tl-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 148rpx;
  padding: 22rpx 4rpx;
  position: relative;
  transition: background 0.12s;
}

.tl-cell:active {
  background: #FCF6F0;
  border-radius: 24rpx;
}

.tl-ico {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  margin-bottom: 8rpx;
  background-size: 36rpx 36rpx;
  background-repeat: no-repeat;
  background-position: center;
}

.tl-txt {
  font-size: 22rpx;
  font-weight: 500;
  color: #5A4A40;
  line-height: 1.2;
}

.tl-badge {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  font-size: 15rpx;
  color: #FFF;
  background: #D4A080;
  padding: 1rpx 10rpx;
  border-radius: 999rpx;
  line-height: 1.5;
}

