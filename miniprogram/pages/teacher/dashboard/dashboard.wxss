.mg-txt {
  font-size: 22rpx;
  font-weight: 500;
  color: #5A4A40;
  line-height: 1.2;
}

.mg-badge {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  font-size: 16rpx;
  color: #FFF;
  background: #D4A080;
  padding: 1rpx 12rpx;
  border-radius: 999rpx;
  line-height: 1.5;
}

/* ===== 动态卡片 ===== */

.dyn-card {
  margin: 24rpx 28rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(200, 170, 150, 0.08);
  overflow: hidden;
}

.dyn-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx 0;
}

.dyn-ttl {
  font-size: 28rpx;
  font-weight: 700;
  color: #4A3A30;
}

.dyn-badge {
  background: #F5EDE5;
  padding: 2rpx 18rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #B09888;
  line-height: 1.6;
}

.dyn-body {
  padding: 16rpx 30rpx 22rpx;
}

.dyn-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #F5EDE5;
}

.dyn-row:last-child {
  border-bottom: none;
}

.dyn-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #E8C8A0;
  margin-right: 16rpx;
  flex-shrink: 0;
  box-shadow: 0 0 6rpx rgba(232, 200, 160, 0.30);
}

.dyn-tm {
  font-size: 22rpx;
  color: #B8A898;
  width: 120rpx;
  flex-shrink: 0;
  font-feature-settings: "tnum";
}

.dyn-tx {
  font-size: 26rpx;
  color: #4A3A30;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dyn-null {
  padding: 36rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #C8B8A8;
}
