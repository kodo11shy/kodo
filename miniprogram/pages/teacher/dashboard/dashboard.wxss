.func-name {
  font-size: 23rpx;
  font-weight: 500;
  color: #3A3530;
  line-height: 1.2;
}

.func-badge {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  font-size: 17rpx;
  color: #FFF;
  background: #4A5550;
  padding: 1rpx 12rpx;
  border-radius: 999rpx;
  line-height: 1.5;
}

/* ===== 动态区块 ===== */

.feed-block {
  margin: 20rpx 24rpx 30rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
}

.feed-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx 0;
}

.feed-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2A2622;
}

.feed-num {
  font-size: 21rpx;
  color: #8A8078;
  background: #F0ECE6;
  padding: 2rpx 16rpx;
  border-radius: 999rpx;
  line-height: 1.6;
}

.feed-body {
  padding: 16rpx 28rpx 20rpx;
}

.feed-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #F0ECE6;
}

.feed-item:last-child {
  border-bottom: none;
}

.feed-bullet {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #B8956A;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.feed-time {
  font-size: 22rpx;
  color: #9A9088;
  width: 120rpx;
  flex-shrink: 0;
  font-feature-settings: "tnum";
}

.feed-text {
  font-size: 26rpx;
  color: #2A2622;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feed-empty {
  padding: 36rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #B0A8A0;
}
