/* ===== 老师工作台 — 暖色版 ===== */

.page {
  min-height: 100vh;
  padding-bottom: 50rpx;
  position: relative;
}

/* ===== 背景氛围渐变 ===== */
.bg-accent {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 420rpx;
  background: linear-gradient(165deg, #E8835A 0%, #F5A623 60%, #F7C948 100%);
  z-index: 0;
  pointer-events: none;
}

/* ===== 顶部区域 ===== */
.dash-header {
  background: linear-gradient(135deg, #E8835A 0%, #F5A623 100%);
  padding: 56rpx 34rpx 42rpx;
  color: #FFFFFF;
  position: relative;
  z-index: 1;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.greeting {
  font-size: 38rpx;
  font-weight: 600;
  display: block;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 8rpx rgba(200, 100, 40, 0.15);
}

.date-text {
  font-size: 24rpx;
  opacity: 0.80;
  margin-top: 8rpx;
  display: block;
  font-weight: 400;
}

.logout-btn {
  font-size: 22rpx;
  opacity: 0.80;
  padding: 8rpx 22rpx;
  border: 2rpx solid rgba(255,255,255,0.30);
  border-radius: 999rpx;
  flex-shrink: 0;
  margin-top: 6rpx;
  backdrop-filter: blur(4rpx);
}

/* ===== 错误提示条 ===== */
.error-banner {
  background: rgba(255, 200, 50, 0.20);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-top: 16rpx;
  text-align: center;
}
.error-banner-text {
  font-size: 24rpx;
  color: #FFF;
  opacity: 0.85;
}

/* ===== 头部出勤统计 ===== */
.header-stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(8rpx);
  border-radius: 20rpx;
  margin-top: 28rpx;
  padding: 28rpx 16rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
}

.stat-label {
  display: block;
  font-size: 22rpx;
  opacity: 0.80;
  margin-top: 6rpx;
  letter-spacing: 1rpx;
}

.stat-rate {
  color: #FFE4B5;
}

.stat-divider {
  width: 2rpx;
  height: 48rpx;
  background: rgba(255,255,255,0.20);
}

/* ===== 九宫格菜单 ===== */
.grid-menu {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  background: #FFFFFF;
  margin: -20rpx 30rpx 20rpx;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 36rpx rgba(200, 160, 130, 0.12);
  padding: 4rpx 0;
  position: relative;
  z-index: 2;
  overflow: hidden;
}

.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 168rpx;
  padding: 24rpx 10rpx;
  position: relative;
  transition: background 0.2s ease;
}

.grid-item:active {
  background: var(--color-primary-light);
}

.grid-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  transition: transform 0.2s ease;
}

.grid-item:active .grid-icon-wrap {
  transform: scale(0.92);
}

.grid-icon {
  width: 46rpx;
  height: 46rpx;
}

.grid-icon-emoji {
  font-size: 38rpx;
  line-height: 1;
}

.grid-label {
  font-size: 24rpx;
  color: var(--color-text);
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

/* 暖色系图标背景 */
.icon-camera-bg { background: #FDF0E8; }
.icon-photolib-bg { background: #FDF6E3; }
.icon-checkin-bg { background: #E8F5EE; }
.icon-homework-bg { background: #FFF0E8; }
.icon-growth-bg { background: #FDF0E8; }
.icon-meal-bg { background: #FFF6E0; }
.icon-students-bg { background: #E8F0F5; }
.icon-payment-bg { background: #F0EDF5; }
.icon-notice-bg { background: #E8F5EE; }
.icon-settings-bg { background: #F5F0EE; }
.icon-admin-bg { background: #FFF0EE; }

/* 管理员徽章 */
.admin-badge {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  font-size: 18rpx;
  color: var(--color-primary);
  background: var(--color-primary-light);
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  line-height: 1.6;
}

/* ===== 今日动态卡片 ===== */
.section-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  margin: 0 30rpx 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 36rpx rgba(200, 160, 130, 0.10);
  position: relative;
  z-index: 1;
  border-top: 4rpx solid var(--color-primary);
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.section-count {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg-teacher);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.dynamic-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F5EDE6;
}

.dynamic-item:last-child {
  border-bottom: none;
}

.dynamic-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--color-primary);
  margin-right: 16rpx;
  flex-shrink: 0;
  box-shadow: 0 0 6rpx rgba(232, 131, 90, 0.30);
}

.dynamic-time {
  font-size: 22rpx;
  color: var(--color-text-muted);
  width: 120rpx;
  flex-shrink: 0;
  font-feature-settings: "tnum";
}

.dynamic-text {
  font-size: 26rpx;
  color: var(--color-text);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 动态为空 */
.empty-state-mini {
  padding: 44rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-muted);
}
