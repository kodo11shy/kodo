/* ===== 晨光 · 老师首页 ===== */
/* 暖杏点缀 · 米白底 · 大圆角 · 柔和光影 */

page, .page {
  min-height: 100vh;
  background: #FCF8F3;
  padding-bottom: 40rpx;
}

/* ===== 晨光顶栏 ===== */

.dawn-bar {
  background: linear-gradient(150deg, #FAF0E8 0%, #FCF6EE 100%);
  padding: 0 0 28rpx 0;
  border-bottom: 2rpx solid #F0E6DA;
}

.dawn-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 44rpx 32rpx 0;
}

.dawn-greet {
  font-size: 30rpx;
  font-weight: 500;
  color: #B8957A;
}

.dawn-user {
  font-size: 30rpx;
  font-weight: 700;
  color: #4A3A30;
  margin-left: 2rpx;
}

.dawn-day {
  display: block;
  font-size: 22rpx;
  color: #B09888;
  margin-top: 6rpx;
  font-feature-settings: "tnum";
}

.dawn-exit {
  font-size: 22rpx;
  color: #C0A890;
  padding: 6rpx 20rpx;
  border: 2rpx solid #E8DACC;
  border-radius: 999rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.dawn-err {
  background: #FDF6E8;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  margin: 20rpx 32rpx 0;
  font-size: 23rpx;
  color: #C09860;
  text-align: center;
}

/* 出勤卡片 */

.dawn-stats {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  margin: 24rpx 32rpx 0;
  border-radius: 20rpx;
  padding: 26rpx 10rpx;
  box-shadow: 0 4rpx 20rpx rgba(200, 170, 150, 0.10);
}

.ds-item {
  flex: 1;
  text-align: center;
}

.ds-num {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #4A3A30;
  line-height: 1.1;
}

.ds-lbl {
  display: block;
  font-size: 21rpx;
  color: #B09888;
  margin-top: 6rpx;
  letter-spacing: 1rpx;
}

.ds-hit {
  color: #E8A870;
}

.ds-gap {
  width: 2rpx;
  height: 40rpx;
  background: #F0E8E0;
}

/* ===== 功能网格 ===== */

.menu-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  padding: 28rpx 28rpx 8rpx;
}

.mg-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 160rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 18rpx 4rpx;
  position: relative;
  box-shadow: 0 4rpx 16rpx rgba(200, 170, 150, 0.06);
  transition: transform 0.12s, box-shadow 0.12s;
}

.mg-cell:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 8rpx rgba(200, 170, 150, 0.08);
}

.mg-ico {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  margin-bottom: 10rpx;
  background-size: 40rpx 40rpx;
  background-repeat: no-repeat;
  background-position: center;
  box-shadow: 0 2rpx 8rpx rgba(200, 120, 80, 0.06);
}

