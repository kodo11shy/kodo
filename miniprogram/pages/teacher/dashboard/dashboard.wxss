/* ===== 动态卡片 ===== */

.feed-card {
  margin: 24rpx 24rpx 30rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(180, 140, 120, 0.06);
  overflow: hidden;
}

.fc-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx 0;
}

.fc-ttl {
  font-size: 27rpx;
  font-weight: 700;
  color: #4A3A30;
}

.fc-tag {
  background: #F5EDE5;
  padding: 2rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #B09888;
  line-height: 1.6;
}

.fc-body {
  padding: 14rpx 28rpx 20rpx;
}

.fc-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #F5EDE5;
}

.fc-row:last-child {
  border-bottom: none;
}

.fc-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #E8C8A0;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.fc-tm {
  font-size: 22rpx;
  color: #B8A898;
  width: 110rpx;
  flex-shrink: 0;
  font-feature-settings: "tnum";
}

.fc-tx {
  font-size: 26rpx;
  color: #4A3A30;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fc-null {
  padding: 36rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #C8B8A8;
}
