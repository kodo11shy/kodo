<view class="page-teacher page">

  <!-- ===== 暖色区块：问候 + 出勤 ===== -->
  <view class="hero-area">
    <view class="hero-inner">
      <view class="hero-top">
        <view class="hero-left">
          <text class="hero-emoji">☀️</text>
          <view class="hero-texts">
            <text class="hero-greet">{{greeting}}，</text>
            <text class="hero-name">{{teacherName}}</text>
          </view>
        </view>
        <view class="hero-exit" bindtap="doLogout">退出</view>
      </view>

      <view class="hero-date">{{dateStr}}</view>

      <view class="hero-err" wx:if="{{attendanceError}}">
        ⚠️ 数据加载异常，请下拉刷新
      </view>

      <!-- 出勤 — 纯文字简约版 -->
      <view class="hero-stats" wx:else bindtap="goAttendance">
        <view class="hs-unit">
          <text class="hs-num">{{attendedCount}}</text>
          <text class="hs-unit-sep">/</text>
          <text class="hs-num hs-num-muted">{{totalCount}}</text>
          <text class="hs-lbl">已签到</text>
        </view>
        <view class="hs-dot"></view>
        <view class="hs-unit">
          <text class="hs-num hs-num-gold">{{attendanceRate}}%</text>
          <text class="hs-lbl">出勤率</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 功能入口 — 白色大卡片 ===== -->
  <view class="tools-card">
    <view class="tools-grid">
      <view class="tl-cell" bindtap="goPhoto">
        <view class="tl-ico tl-cam"></view>
        <text class="tl-txt">拍照</text>
      </view>
      <view class="tl-cell" bindtap="goPhotoLib">
        <view class="tl-ico tl-album"></view>
        <text class="tl-txt">照片库</text>
      </view>
      <view class="tl-cell" bindtap="goAttendance">
        <view class="tl-ico tl-sign"></view>
        <text class="tl-txt">签到</text>
      </view>
      <view class="tl-cell" bindtap="goHomework">
        <view class="tl-ico tl-hw"></view>
        <text class="tl-txt">作业</text>
      </view>
      <view class="tl-cell" bindtap="goGrowth">
        <view class="tl-ico tl-grow"></view>
        <text class="tl-txt">成长</text>
      </view>
      <view class="tl-cell" bindtap="goMeal">
        <view class="tl-ico tl-meal"></view>
        <text class="tl-txt">餐食</text>
      </view>
      <view class="tl-cell" bindtap="goStudents">
        <view class="tl-ico tl-stud"></view>
        <text class="tl-txt">学生</text>
      </view>
      <view class="tl-cell" bindtap="goPayment">
        <view class="tl-ico tl-pay"></view>
        <text class="tl-txt">收费</text>
      </view>
      <view class="tl-cell" bindtap="goNotices">
        <view class="tl-ico tl-ntf"></view>
        <text class="tl-txt">通知</text>
      </view>
      <view class="tl-cell" bindtap="goSettings">
        <view class="tl-ico tl-set"></view>
        <text class="tl-txt">设置</text>
      </view>
      <view class="tl-cell" wx:if="{{isAdmin}}" bindtap="goAdmin">
        <view class="tl-ico tl-adm"></view>
        <text class="tl-txt">管理</text>
        <view class="tl-badge">管理员</view>
      </view>
    </view>
  </view>

  <!-- ===== 今日动态 ===== -->
  <view class="feed-card">
    <view class="fc-head">
      <text class="fc-ttl">今日动态</text>
      <view class="fc-tag" wx:if="{{recentActivities.length > 0}}">
        <text>{{recentActivities.length}} 条</text>
      </view>
    </view>
    <view class="fc-body">
      <view class="fc-row" wx:for="{{recentActivities}}" wx:key="index">
        <view class="fc-dot"></view>
        <text class="fc-tm">{{item.time}}</text>
        <text class="fc-tx">{{item.text}}</text>
      </view>
      <view class="fc-null" wx:if="{{recentActivities.length === 0}}">
        <text>暂无记录</text>
      </view>
    </view>
  </view>

</view>
