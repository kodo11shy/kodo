.page { min-height: 100vh; background: #F7F8FC; }

/* 头部 */
.profile-header {
  display: flex;
  align-items: center;
  padding: 40rpx 30rpx;
  background: #5B7FFF;
  color: #FFF;
}
.profile-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.3);
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.profile-info { flex: 1; margin-left: 24rpx; }
.profile-name { font-size: 36rpx; font-weight: bold; display: block; }
.profile-meta { font-size: 24rpx; opacity: 0.9; margin-top: 6rpx; display: block; }
.profile-status { margin-top: 8rpx; display: inline-block !important; }
.edit-btn {
  background: rgba(255,255,255,0.2);
  color: #FFF;
  border: 2rpx solid rgba(255,255,255,0.4);
  font-size: 26rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
}

/* 选项卡 */
.tab-bar {
  display: flex;
  background: #FFF;
  border-bottom: 2rpx solid #EEE;
  position: sticky;
  top: 0;
  z-index: 10;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}
.tab-item.active {
  color: #5B7FFF;
  font-weight: bold;
}
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 20%;
  width: 60%;
  height: 4rpx;
  background: #5B7FFF;
  border-radius: 2rpx;
}

.tab-content { padding: 20rpx 30rpx; }

/* 信息网格 */
.info-grid { display: flex; flex-wrap: wrap; }
.info-item {
  width: 50%;
  padding: 20rpx 16rpx;
  border-bottom: 2rpx solid #ECEFF5;
}
.info-full { width: 100%; }
.info-label { font-size: 24rpx; color: #999; display: block; margin-bottom: 8rpx; }
.info-value { font-size: 28rpx; color: #333; display: block; }

/* 快捷操作 */
.quick-actions {
  padding: 30rpx 0;
  display: flex;
  gap: 20rpx;
}
.quick-actions .btn-secondary { flex: 1; font-size: 28rpx; }

/* 编辑表单 */
.edit-form { padding: 10rpx 0; }
.detail-field { margin-bottom: 24rpx; }
.detail-label { font-size: 26rpx; color: #666; margin-bottom: 8rpx; display: block; }
.detail-input {
  width: 100%;
  height: 76rpx;
  min-height: 76rpx;
  line-height: 76rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  border: 2rpx solid #E5EAF2;
  background: #FFFFFF;
  color: #2F3A4C;
  font-size: 27rpx;
}
.detail-textarea {
  height: 160rpx;
  line-height: 1.5;
  padding: 18rpx 22rpx;
}
.detail-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}
.detail-btn {
  flex: 1;
  height: 82rpx;
  line-height: 82rpx;
  padding: 0;
  border: none;
  border-radius: 18rpx;
  font-size: 29rpx;
  font-weight: 700;
}
.detail-btn::after { border: none; }
.detail-btn.cancel { background: #F0F2F6; color: #697386; }
.detail-btn.primary { background: #5B7FFF; color: #FFFFFF; }

/* 家长卡片 */
.parent-card {
  display: flex;
  align-items: flex-start;
  background: #FFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.parent-avatar {
  width: 72rpx; height: 72rpx;
  border-radius: 50%;
  background: #EEF2FF;
  color: #5B7FFF;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.parent-info { flex: 1; margin-left: 16rpx; }
.parent-name { font-size: 30rpx; font-weight: bold; display: block; }
.parent-relation { display: inline-block !important; margin: 6rpx 0; }
.parent-phone { font-size: 24rpx; color: #999; display: block; }
.parent-invite { text-align: center; margin-left: 12rpx; }
.invite-label { font-size: 20rpx; color: #999; display: block; }
.invite-code { font-size: 28rpx; color: #5B7FFF; font-weight: bold; letter-spacing: 2rpx; }

/* 接送授权人 */
.section-actions { margin-bottom: 20rpx; }
.pickup-card {
  display: flex;
  align-items: center;
  background: #FFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.pickup-avatar {
  width: 72rpx; height: 72rpx;
  border-radius: 50%;
  background: #E8F8E8;
  color: #27AE60;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.pickup-info { flex: 1; margin-left: 16rpx; }
.pickup-name { font-size: 30rpx; font-weight: bold; display: block; }
.pickup-relation { display: inline-block !important; margin: 6rpx 6rpx 6rpx 0; }
.pickup-phone { font-size: 24rpx; color: #999; display: block; margin-top: 4rpx; }
.pickup-tag { display: inline-block !important; }

/* 健康 */
.health-card {
  background: #FFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.health-row {
  padding: 16rpx 0;
  border-bottom: 2rpx solid #ECEFF5;
}
.health-row:last-child { border-bottom: none; }
.health-label { font-size: 24rpx; color: #999; display: block; margin-bottom: 4rpx; }
.health-value { font-size: 28rpx; color: #333; }
.consent-section {
  background: #FFF;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.consent-title { font-size: 28rpx; font-weight: bold; display: block; margin-bottom: 16rpx; }
.consent-status { display: flex; align-items: center; gap: 20rpx; }
.consent-btn { font-size: 24rpx; height: 60rpx; line-height: 60rpx; padding: 0 20rpx; width: auto; flex-shrink: 0; }

/* 接送编辑弹窗 */
.pickup-sheet-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx 0;
  box-sizing: border-box;
  background: rgba(18, 24, 38, 0.58);
}

.pickup-sheet {
  width: 88vw;
  max-width: 660rpx;
  max-height: 86vh;
  background: #FFFFFF;
  border-radius: 28rpx;
  overflow: hidden;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20rpx 60rpx rgba(16, 26, 52, 0.24);
}

.pickup-sheet-head {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 30rpx 22rpx;
  border-bottom: 2rpx solid #EEF1F6;
}

.pickup-sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2F3A4C;
}

.pickup-sheet-close {
  width: 58rpx;
  height: 58rpx;
  line-height: 54rpx;
  text-align: center;
  border-radius: 50%;
  background: #F2F4F8;
  color: #697386;
  font-size: 40rpx;
}

.pickup-sheet-body {
  max-height: calc(86vh - 190rpx);
  padding: 24rpx 30rpx 8rpx;
  box-sizing: border-box;
}

.pickup-edit-row {
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: #F8FAFD;
  border: 2rpx solid #EEF1F6;
  border-radius: 18rpx;
}

.pickup-row-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.pickup-row-title {
  font-size: 25rpx;
  font-weight: 700;
  color: #2F3A4C;
}

.pickup-remove-btn {
  color: #E65F5C;
  font-size: 24rpx;
  padding: 6rpx 12rpx;
}

.pickup-input {
  width: 100%;
  height: 76rpx;
  min-height: 76rpx;
  line-height: 76rpx;
  padding: 0 22rpx;
  margin-bottom: 14rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  border: 2rpx solid #E5EAF2;
  background: #FFFFFF;
  color: #2F3A4C;
  font-size: 27rpx;
}

.pickup-input:last-child {
  margin-bottom: 0;
}

.pickup-add-btn {
  width: 100%;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0;
  margin: 4rpx 0 16rpx;
  border: 2rpx dashed #BFD0FF;
  border-radius: 16rpx;
  background: #F6F8FF;
  color: #5B7FFF;
  font-size: 27rpx;
}

.pickup-add-btn::after,
.pickup-sheet-btn::after {
  border: none;
}

.pickup-sheet-actions {
  flex-shrink: 0;
  display: flex;
  gap: 18rpx;
  padding: 20rpx 30rpx 26rpx;
  background: #FFFFFF;
  border-top: 2rpx solid #EEF1F6;
}

.pickup-sheet-btn {
  flex: 1;
  height: 82rpx;
  line-height: 82rpx;
  padding: 0;
  border: none;
  border-radius: 18rpx;
  font-size: 29rpx;
  font-weight: 700;
}

.pickup-sheet-btn.cancel {
  background: #F0F2F6;
  color: #697386;
}

.pickup-sheet-btn.primary {
  background: #5B7FFF;
  color: #FFFFFF;
}

/* 空状态补充 */
.empty-desc { font-size: 24rpx; color: #BBB; margin-top: 10rpx; }
