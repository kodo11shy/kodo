.page { min-height: 100vh; background: #F7F8FC; }

/* 设置卡片 */
.section-card {
  background: rgba(255,255,255,0.92);
  border-radius: 24rpx;
  margin: 20rpx 30rpx;
  padding: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(49,64,90,0.08);
  border: 1rpx solid rgba(255,255,255,0.8);
}
.card-title { font-size: 30rpx; font-weight: bold; display: block; margin-bottom: 20rpx; color: #2F3A4C; }

.field-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #ECEFF5;
}
.field-row:last-child { border-bottom: none; }
.field-label { font-size: 26rpx; color: #7B8496; width: 200rpx; flex-shrink: 0; }
.field-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #2F3A4C;
  padding: 8rpx 0;
}
.field-picker {
  min-width: 220rpx;
  text-align: right;
  font-size: 28rpx;
  color: #2F3A4C;
  padding: 8rpx 0;
}
.field-inline {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 10rpx;
}
.small-input {
  flex: none;
  width: 120rpx;
}
.field-unit {
  font-size: 26rpx;
  color: #7B8496;
}
.login-note {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #7B8496;
}
.wechat-bind-row {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid #ECEFF5;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.wechat-bind-title {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
  color: #2F3A4C;
}
.wechat-bind-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #7B8496;
  line-height: 1.4;
}
.bind-btn {
  flex-shrink: 0;
  min-width: 150rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 22rpx;
  border-radius: 14rpx;
  background: #F1F8F3;
  color: #1F8F4D;
  border: 2rpx solid #BFE7CC;
  font-size: 25rpx;
}

/* 统一收费列表 */
.fee-list {
  border-top: 2rpx solid #ECEFF5;
}
.fee-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F0F2F6;
}
.fee-item:last-child { border-bottom: none; }

.fee-item-info {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}
.fee-item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2F3A4C;
  display: block;
}
.fee-item-meta {
  font-size: 24rpx;
  color: #7B8496;
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}
.fee-item-amount {
  font-size: 26rpx;
  font-weight: 600;
  color: #5B7FFF;
  margin-right: 4rpx;
}
.fee-item-unit {
  font-size: 22rpx;
  color: #7B8496;
  margin-right: 8rpx;
}
.fee-item-desc {
  font-size: 22rpx;
  color: #B1B8C7;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 200rpx;
}

.fee-item-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}
.fee-action-btn {
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  border: 2rpx solid transparent;
}
.fee-action-btn:active { opacity: 0.7; }
.edit-btn {
  color: #5B7FFF;
  border-color: #D6E0FF;
  background: rgba(91,127,255,0.06);
}
.delete-btn {
  color: #D84A3A;
  border-color: #FFD6D0;
  background: rgba(216,74,58,0.06);
}

/* 添加收费按钮 */
.add-fee-row {
  padding: 20rpx 0 4rpx;
  border-top: 2rpx solid #F0F2F6;
  text-align: center;
}
.add-fee-btn {
  display: inline-block;
  font-size: 26rpx;
  color: #5B7FFF;
  font-weight: 600;
  padding: 10rpx 32rpx;
  border: 2rpx solid #5B7FFF;
  border-radius: 999rpx;
  background: rgba(91,127,255,0.04);
}
.add-fee-btn:active { opacity: 0.7; background: rgba(91,127,255,0.1); }

/* 保存按钮 */
.save-section { padding: 10rpx 30rpx 30rpx; }
.change-hint { font-size: 24rpx; color: #D84A3A; display: block; text-align: center; margin-bottom: 12rpx; }
.save-btn { font-size: 28rpx; }

/* 菜单 */
.menu-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #2F3A4C;
  border-bottom: 2rpx solid #ECEFF5;
}
.menu-row:last-child { border-bottom: none; }
.menu-row:active { opacity: 0.6; }
.menu-arrow { font-size: 32rpx; color: #C7CDD8; }
.logout-text { color: #D84A3A; }

/* 弹窗样式 */
.fee-sheet-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx 0;
  box-sizing: border-box;
  background: rgba(18, 24, 38, 0.58);
}
.fee-sheet {
  width: 88vw;
  max-width: 660rpx;
  max-height: 84vh;
  background: #FFFFFF;
  border-radius: 28rpx;
  overflow: hidden;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20rpx 60rpx rgba(16, 26, 52, 0.24);
}
.fee-sheet-head {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 30rpx 22rpx;
  border-bottom: 2rpx solid #EEF1F6;
}
.fee-sheet-title { font-size: 34rpx; font-weight: bold; color: #2F3A4C; display: block; }
.fee-sheet-close {
  width: 58rpx;
  height: 58rpx;
  line-height: 54rpx;
  text-align: center;
  border-radius: 50%;
  background: #F2F4F8;
  color: #697386;
  font-size: 40rpx;
}
.fee-sheet-body {
  padding: 26rpx 30rpx 6rpx;
  box-sizing: border-box;
}
.fee-field { margin-bottom: 24rpx; min-width: 0; }
.fee-label { font-size: 26rpx; color: #7B8496; display: block; margin-bottom: 10rpx; }
.fee-row { display: flex; gap: 20rpx; }
.fee-half { flex: 1; min-width: 0; }
.fee-input {
  width: 100%;
  height: 76rpx;
  line-height: 76rpx;
  min-height: 76rpx;
  padding: 0 22rpx;
  border-radius: 14rpx;
  border: 2rpx solid #E5EAF2;
  box-sizing: border-box;
  background: #FFFFFF;
  color: #2F3A4C;
  font-size: 27rpx;
  text-align: left;
}
.fee-sheet-actions {
  flex-shrink: 0;
  display: flex;
  gap: 18rpx;
  padding: 20rpx 30rpx 26rpx;
  border-top: 2rpx solid #EEF1F6;
}
.fee-sheet-btn {
  flex: 1;
  height: 82rpx;
  line-height: 82rpx;
  padding: 0;
  border: none;
  border-radius: 18rpx;
  font-size: 29rpx;
  font-weight: 700;
}
.fee-sheet-btn::after { border: none; }
.fee-sheet-btn.cancel { background: #F0F2F6; color: #697386; }
.fee-sheet-btn.primary { background: #5B7FFF; color: #FFFFFF; }
