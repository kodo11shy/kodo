.page {
  min-height: 100vh;
  background: #F6F8FB;
  padding-bottom: 42rpx;
  box-sizing: border-box;
}

.overview-card {
  margin: 28rpx 28rpx 20rpx;
  padding: 30rpx;
  border-radius: 18rpx;
  background: #4F72F6;
  color: #FFFFFF;
}

.overview-head,
.section-row,
.meal-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.overview-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
}

.overview-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  opacity: 0.86;
}

.mini-action {
  flex-shrink: 0;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  font-size: 25rpx;
  font-weight: 600;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 26rpx;
}

.metric-item {
  min-width: 0;
  padding: 16rpx 10rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.14);
  text-align: center;
}

.metric-value {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
}

.metric-label {
  display: block;
  margin-top: 5rpx;
  font-size: 21rpx;
  opacity: 0.88;
}

.today-card,
.today-empty,
.meal-card,
.form-section {
  margin: 0 28rpx 20rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(38, 53, 89, 0.06);
}

.today-card {
  overflow: hidden;
}

.today-cover image {
  display: block;
  width: 100%;
  height: 300rpx;
  background: #EEF1F6;
}

.today-body,
.today-empty {
  padding: 28rpx;
}

.today-empty {
  text-align: center;
}

.section-title,
.history-title,
.form-section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2D3748;
}

.edit-link,
.text-action {
  flex-shrink: 0;
  font-size: 25rpx;
  color: #4F72F6;
  font-weight: 600;
}

.meal-menu {
  display: block;
  margin-top: 12rpx;
  font-size: 31rpx;
  font-weight: 700;
  color: #1F2937;
  line-height: 1.45;
}

.meal-remark {
  display: block;
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #667085;
  line-height: 1.5;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.meta-row text {
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: #F1F5FF;
  color: #4F72F6;
  font-size: 23rpx;
}

.meta-row.compact {
  margin-top: 12rpx;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #2D3748;
}

.empty-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #8A94A6;
  line-height: 1.45;
}

.primary-btn {
  margin-top: 24rpx;
  width: 360rpx;
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 999rpx;
  background: #4F72F6;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
}

.history-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 26rpx 28rpx 18rpx;
}

.history-count,
.section-hint {
  font-size: 23rpx;
  color: #8A94A6;
}

.meal-list {
  padding: 0 28rpx;
}

.meal-card {
  display: flex;
  gap: 18rpx;
  margin-left: 0;
  margin-right: 0;
  padding: 18rpx;
  box-sizing: border-box;
}

.meal-cover {
  flex-shrink: 0;
  width: 168rpx;
  height: 168rpx;
  border-radius: 14rpx;
  background: #EEF1F6;
}

.meal-cover.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #98A2B3;
  font-size: 25rpx;
}

.meal-info {
  flex: 1;
  min-width: 0;
}

.meal-date {
  font-size: 25rpx;
  color: #667085;
}

.meal-edit {
  color: #4F72F6;
  font-size: 24rpx;
}

.line-clamp {
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.loading-container,
.empty-state {
  padding: 56rpx 28rpx;
  text-align: center;
  color: #8A94A6;
}

.empty-image {
  width: 220rpx;
  height: 160rpx;
  margin-bottom: 18rpx;
}

.meal-sheet-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx 0;
  background: rgba(17, 24, 39, 0.55);
  z-index: 1000;
  box-sizing: border-box;
}

.meal-sheet {
  width: 90vw;
  max-width: 670rpx;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 20rpx 56rpx rgba(15, 23, 42, 0.24);
}

.meal-sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  padding: 28rpx 30rpx 20rpx;
  border-bottom: 2rpx solid #EEF1F6;
}

.meal-sheet-title {
  display: block;
  font-size: 33rpx;
  font-weight: 700;
  color: #1F2937;
}

.meal-sheet-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #8A94A6;
}

.meal-sheet-close {
  flex-shrink: 0;
  width: 62rpx;
  height: 62rpx;
  line-height: 58rpx;
  text-align: center;
  border-radius: 50%;
  background: #F2F4F7;
  color: #667085;
  font-size: 42rpx;
}

.meal-sheet-body {
  max-height: calc(88vh - 190rpx);
  padding: 22rpx 0 18rpx;
  box-sizing: border-box;
}

.form-section {
  margin-bottom: 20rpx;
  padding: 22rpx;
  box-shadow: none;
  border: 2rpx solid #EEF1F6;
}

.last-section {
  margin-bottom: 6rpx;
}

.meal-field {
  margin-top: 18rpx;
}

.meal-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 23rpx;
  color: #667085;
}

.meal-picker,
.meal-textarea {
  width: 100%;
  box-sizing: border-box;
  border-radius: 14rpx;
  border: 2rpx solid #E4E9F2;
  background: #FFFFFF;
  color: #1F2937;
  font-size: 27rpx;
}

.meal-picker {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 20rpx;
}

.meal-textarea {
  padding: 18rpx 20rpx;
  line-height: 1.45;
}

.menu-textarea {
  height: 134rpx;
}

.remark-textarea {
  height: 112rpx;
}

.hint-box {
  margin-top: 16rpx;
  padding: 24rpx;
  border-radius: 14rpx;
  background: #F8FAFC;
  color: #8A94A6;
  font-size: 24rpx;
  text-align: center;
}

.thumb-grid,
.photo-library,
.student-grid {
  display: grid;
  gap: 12rpx;
  margin-top: 16rpx;
}

.thumb-grid,
.photo-library {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.thumb-wrap,
.library-photo {
  position: relative;
  height: 178rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: #EEF1F6;
}

.thumb,
.library-photo image {
  width: 100%;
  height: 100%;
}

.thumb-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 34rpx;
  height: 34rpx;
  line-height: 30rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(31, 41, 55, 0.78);
  color: #FFFFFF;
  font-size: 24rpx;
}

.library-photo.selected {
  outline: 5rpx solid #4F72F6;
}

.selected-mark,
.cover-mark,
.cover-btn {
  position: absolute;
  left: 8rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  color: #FFFFFF;
  font-size: 20rpx;
}

.selected-mark {
  top: 8rpx;
  background: rgba(79, 114, 246, 0.9);
}

.cover-mark {
  bottom: 8rpx;
  background: rgba(16, 185, 129, 0.92);
}

.cover-btn {
  right: 8rpx;
  bottom: 8rpx;
  left: auto;
  background: rgba(31, 41, 55, 0.82);
}

.student-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.student-chip {
  min-width: 0;
  padding: 18rpx;
  border-radius: 14rpx;
  border: 2rpx solid #E4E9F2;
  background: #FFFFFF;
}

.student-chip.selected {
  border-color: #4F72F6;
  background: #F1F5FF;
}

.student-name {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #1F2937;
}

.student-grade {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8A94A6;
}

.meal-sheet-actions {
  flex-shrink: 0;
  display: flex;
  gap: 18rpx;
  padding: 18rpx 30rpx 24rpx;
  border-top: 2rpx solid #EEF1F6;
  background: #FFFFFF;
}

.sheet-btn {
  flex: 1;
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 18rpx;
  border: none;
  padding: 0;
  font-size: 29rpx;
  font-weight: 700;
}

.cancel-btn {
  background: #F2F4F7;
  color: #667085;
}

.save-btn {
  background: #4F72F6;
  color: #FFFFFF;
}

.save-btn[disabled] {
  opacity: 0.6;
}
