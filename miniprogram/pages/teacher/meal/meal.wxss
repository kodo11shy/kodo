.page { min-height: 100vh; background: #F7F8FC; padding-bottom: 40rpx; }

/* 状态卡 */
.overview-card {
  background: #5B7FFF;
  margin: 30rpx;
  border-radius: 20rpx;
  padding: 32rpx;
  color: #FFF;
}
.overview-head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24rpx; }
.overview-title { font-size: 34rpx; font-weight: bold; display: block; }
.overview-subtitle { font-size: 24rpx; opacity: 0.85; margin-top: 6rpx; display: block; }
.mini-action {
  background: rgba(255,255,255,0.25);
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
}
.metric-grid { display: flex; gap: 16rpx; }
.metric-item { flex: 1; text-align: center; }
.metric-value { font-size: 40rpx; font-weight: bold; display: block; }
.metric-label { font-size: 22rpx; opacity: 0.85; margin-top: 4rpx; display: block; }

/* 待处理卡 */
.todo-card {
  background: #FFF;
  margin: 0 30rpx 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.todo-head { display: flex; justify-content: space-between; margin-bottom: 16rpx; }
.todo-title { font-size: 28rpx; font-weight: bold; }
.todo-count { font-size: 24rpx; color: #FF6B35; }
.todo-row {
  display: flex; justify-content: space-between;
  padding: 16rpx 0;
  border-top: 2rpx solid #ECEFF5;
  font-size: 26rpx;
}
.todo-row:first-of-type { border-top: none; }
.todo-num { color: #5B7FFF; }

/* 筛选 */
.filter-scroll { white-space: nowrap; padding: 0 30rpx 20rpx; }
.filter-row { display: inline-flex; gap: 16rpx; }
.filter-chip {
  display: inline-flex; align-items: center; gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  background: #FFF;
  border: 2rpx solid #E8E8E8;
  color: #666;
}
.filter-chip.active {
  background: #5B7FFF;
  border-color: #5B7FFF;
  color: #FFF;
}
.filter-count {
  background: rgba(0,0,0,0.06);
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}
.filter-chip.active .filter-count {
  background: rgba(255,255,255,0.25);
}

/* 餐食卡片 */
.meal-list { padding: 0 30rpx 30rpx; }
.meal-card {
  background: #FFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.meal-header-row { display: flex; justify-content: space-between; align-items: center; }
.meal-header-left { display: flex; align-items: center; gap: 12rpx; }
.meal-date { font-size: 28rpx; font-weight: bold; }
.meal-type { font-size: 22rpx !important; }
.meal-menu { font-size: 30rpx; margin-top: 12rpx; display: block; color: #333; }
.meal-remark { font-size: 26rpx; color: #666; margin-top: 8rpx; display: block; }
.meal-photos { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 12rpx; }
.meal-thumb { width: 160rpx; height: 160rpx; border-radius: 12rpx; background: #F5F5F5; }
.card-arrow { color: #CCC; font-size: 28rpx; padding: 8rpx; }

/* 展开详情 */
.meal-detail { margin-top: 16rpx; padding-top: 16rpx; border-top: 2rpx solid #F0F0F0; }
.detail-section { margin-bottom: 12rpx; }
.detail-label { font-size: 24rpx; font-weight: bold; color: #999; display: block; margin-bottom: 8rpx; }
.detail-section text { font-size: 24rpx; color: #666; display: block; line-height: 1.6; }
.photo-group-badges { display: flex; flex-wrap: wrap; gap: 8rpx; }
.group-badge {
  font-size: 22rpx;
  color: #666;
  background: #F5F5F5;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

/* 餐食表单底部面板 */
.meal-sheet-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(18, 24, 38, 0.58);
  z-index: 1000;
  padding: 36rpx 0;
  box-sizing: border-box;
}

.meal-sheet {
  width: 88vw;
  max-width: 660rpx;
  max-height: 86vh;
  background: #FFFFFF;
  border-radius: 30rpx;
  box-shadow: 0 20rpx 60rpx rgba(16, 26, 52, 0.24);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.meal-sheet-header {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx 20rpx;
  border-bottom: 2rpx solid #EEF1F6;
}

.meal-sheet-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #2F3A4C;
  line-height: 1.25;
}

.meal-sheet-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #8B94A7;
}

.meal-sheet-close {
  width: 64rpx;
  height: 64rpx;
  line-height: 58rpx;
  text-align: center;
  border-radius: 50%;
  background: #F2F4F8;
  color: #697386;
  font-size: 44rpx;
  flex-shrink: 0;
}

.meal-sheet-body {
  max-height: calc(86vh - 198rpx);
  box-sizing: border-box;
  padding: 22rpx 30rpx 18rpx;
}

.form-section {
  margin-bottom: 22rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #F8FAFD;
  border: 2rpx solid #EEF1F6;
}

.last-section {
  margin-bottom: 10rpx;
}

.form-section-title {
  display: block;
  margin-bottom: 16rpx;
  font-size: 25rpx;
  font-weight: 700;
  color: #2F3A4C;
}

.section-headline {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-hint {
  font-size: 22rpx;
  color: #9AA3B5;
}

.form-two-col {
  display: flex;
  gap: 16rpx;
}

.meal-field {
  margin-bottom: 18rpx;
}

.meal-field:last-child {
  margin-bottom: 0;
}

.meal-field.compact {
  flex: 1;
  min-width: 0;
}

.meal-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 23rpx;
  color: #7B8496;
}

.meal-picker,
.meal-textarea {
  width: 100%;
  box-sizing: border-box;
  border-radius: 14rpx;
  border: 2rpx solid #E5EAF2;
  background: #FFFFFF;
  color: #2F3A4C;
  font-size: 27rpx;
}

.meal-picker {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 20rpx;
}

.meal-textarea {
  min-height: 112rpx;
  padding: 18rpx 20rpx;
  line-height: 1.45;
}

.menu-textarea {
  height: 128rpx;
}

.remark-textarea {
  height: 112rpx;
}

.note-grid {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.note-field {
  display: flex;
  align-items: center;
  min-height: 76rpx;
  background: #FFFFFF;
  border: 2rpx solid #E5EAF2;
  border-radius: 14rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
}

.note-label {
  width: 86rpx;
  flex-shrink: 0;
  color: #5B7FFF;
  font-size: 24rpx;
  font-weight: 700;
}

.note-input {
  flex: 1;
  min-width: 0;
  height: 74rpx;
  color: #2F3A4C;
  font-size: 26rpx;
}

/* 照片分组 */
.compact-groups {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.photo-group {
  min-width: 0;
  padding: 16rpx;
  background: #FFFFFF;
  border: 2rpx solid #E5EAF2;
  border-radius: 16rpx;
}

.photo-group-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10rpx;
}

.photo-group-label {
  min-width: 0;
  font-size: 23rpx;
  color: #596276;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.photo-add-btn {
  flex-shrink: 0;
  font-size: 23rpx;
  color: #5B7FFF;
  padding: 4rpx 0 4rpx 12rpx;
}

.photo-thumbs {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.thumb-wrap {
  position: relative;
}

.thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 10rpx;
  background: #EEF1F6;
}

.thumb-remove {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 32rpx;
  height: 32rpx;
  line-height: 29rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(47, 58, 76, 0.82);
  color: #FFFFFF;
  font-size: 24rpx;
}

.meal-sheet-actions {
  flex-shrink: 0;
  display: flex;
  gap: 18rpx;
  padding: 18rpx 30rpx 24rpx;
  background: #FFFFFF;
  border-top: 2rpx solid #EEF1F6;
}

.sheet-btn {
  flex: 1;
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 18rpx;
  font-size: 29rpx;
  font-weight: 700;
  padding: 0;
  border: none;
}

.cancel-btn {
  background: #F0F2F6;
  color: #697386;
}

.save-btn {
  background: #5B7FFF;
  color: #FFFFFF;
}

.save-btn[disabled] {
  opacity: 0.6;
}
