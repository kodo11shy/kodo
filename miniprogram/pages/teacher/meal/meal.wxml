<view class="page">
  <view class="overview-card">
    <view class="overview-head">
      <view>
        <text class="overview-title">今日餐食</text>
        <text class="overview-subtitle">每天只记录一条餐食</text>
      </view>
      <view class="mini-action" bindtap="openTodayForm">{{primaryActionText}}</view>
    </view>
    <view class="metric-grid">
      <view class="metric-item">
        <text class="metric-value">{{todayStatusText}}</text>
        <text class="metric-label">今日状态</text>
      </view>
      <view class="metric-item">
        <text class="metric-value">{{weekRecordedDays}}</text>
        <text class="metric-label">本周已记录</text>
      </view>
      <view class="metric-item">
        <text class="metric-value">{{monthRecordedDays}}</text>
        <text class="metric-label">本月已记录</text>
      </view>
    </view>
  </view>

  <view class="today-card" wx:if="{{todayRecorded && todayMeal}}">
    <view class="today-cover" wx:if="{{todayMeal.coverUrl}}" bindtap="previewMealPhoto" data-url="{{todayMeal.coverPreviewUrl}}">
      <image src="{{todayMeal.coverUrl}}" mode="aspectFill" lazy-load></image>
    </view>
    <view class="today-body">
      <view class="section-row">
        <text class="section-title">今天吃了什么</text>
        <text class="edit-link" bindtap="openTodayForm">编辑</text>
      </view>
      <text class="meal-menu">{{todayMeal.menuText}}</text>
      <text class="meal-remark" wx:if="{{todayMeal.remarkText}}">{{todayMeal.remarkText}}</text>
      <view class="meta-row">
        <text>{{todayMeal.photoCount}} 张照片</text>
        <text>{{todayMeal.studentCount}} 个孩子</text>
      </view>
    </view>
  </view>

  <view class="today-empty" wx:elif="{{!loading}}">
    <text class="empty-title">今日餐食尚未记录</text>
    <text class="empty-desc">记录今天吃了什么，家长端和成长档案就能看到</text>
    <button class="primary-btn" bindtap="openTodayForm">记录今日餐食</button>
  </view>

  <view class="history-head">
    <text class="history-title">历史餐食记录</text>
    <text class="history-count">共 {{records.length}} 天</text>
  </view>

  <view class="loading-container" wx:if="{{loading}}"><text>加载中...</text></view>

  <view class="meal-list" wx:if="{{!loading && records.length > 0}}">
    <view class="meal-card" wx:for="{{records}}" wx:key="id" data-id="{{item.id}}" bindtap="openEditForm">
      <image class="meal-cover" wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" lazy-load />
      <view class="meal-cover placeholder" wx:else>
        <text>餐食</text>
      </view>
      <view class="meal-info">
        <view class="meal-row">
          <text class="meal-date">{{item.date}}</text>
          <text class="meal-edit">编辑</text>
        </view>
        <text class="meal-menu line-clamp">{{item.menuText}}</text>
        <text class="meal-remark line-clamp" wx:if="{{item.remarkText}}">{{item.remarkText}}</text>
        <view class="meta-row compact">
          <text>{{item.photoCount}} 张照片</text>
          <text>{{item.studentCount}} 个孩子</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{!loading && records.length === 0}}">
    <image class="empty-image" src="/images/empty-photos-v2.png" mode="aspectFit"></image>
    <text class="empty-title">{{emptyTitle}}</text>
    <text class="empty-desc">{{emptyDesc}}</text>
  </view>

  <view class="meal-sheet-overlay" wx:if="{{showForm}}" bindtap="closeForm">
    <view class="meal-sheet" catchtap="nop">
      <view class="meal-sheet-header">
        <view>
          <text class="meal-sheet-title">{{formTitle}}</text>
          <text class="meal-sheet-subtitle">{{form.meal_date}}</text>
        </view>
        <text class="meal-sheet-close" bindtap="closeForm">×</text>
      </view>

      <scroll-view class="meal-sheet-body" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="form-section">
          <text class="form-section-title">基础信息</text>
          <view class="meal-field">
            <text class="meal-label">日期</text>
            <picker mode="date" value="{{form.meal_date}}" bindchange="onDateChange">
              <view class="meal-picker">{{form.meal_date}}</view>
            </picker>
          </view>
          <view class="meal-field">
            <text class="meal-label">菜单/菜名</text>
            <textarea class="meal-textarea menu-textarea" placeholder="例如：土豆炖排骨、清炒青菜" value="{{form.menu_text}}" bindinput="onFormField" data-field="menu_text" />
          </view>
          <view class="meal-field">
            <text class="meal-label">备注</text>
            <textarea class="meal-textarea remark-textarea" placeholder="例如：今天孩子们吃得很好" value="{{form.overall_remark}}" bindinput="onFormField" data-field="overall_remark" />
          </view>
        </view>

        <view class="form-section">
          <view class="section-row">
            <text class="form-section-title">新拍/上传照片</text>
            <text class="text-action" bindtap="addPhotos">添加</text>
          </view>
          <view class="thumb-grid" wx:if="{{tempFiles.length > 0}}">
            <view class="thumb-wrap" wx:for="{{tempFiles}}" wx:key="path">
              <image class="thumb" src="{{item.path}}" mode="aspectFill" />
              <text class="thumb-remove" bindtap="removeTempPhoto" data-index="{{index}}">×</text>
            </view>
          </view>
          <view class="hint-box" wx:else>可以现场拍照，也可以从手机相册上传。</view>
        </view>

        <view class="form-section">
          <view class="section-row">
            <text class="form-section-title">从照片库选择</text>
            <text class="section-hint">{{selectedPhotoIds.length}} 张已选</text>
          </view>
          <view class="photo-library" wx:if="{{photoRows.length > 0}}">
            <view class="library-photo {{item.selected ? 'selected' : ''}}" wx:for="{{photoRows}}" wx:key="id" data-id="{{item.id}}" bindtap="toggleLibraryPhoto">
              <image src="{{item.url}}" mode="aspectFill" lazy-load />
              <text class="selected-mark" wx:if="{{item.selected}}">已选</text>
              <text class="cover-mark" wx:if="{{item.isCover}}">封面</text>
              <text class="cover-btn" wx:if="{{item.selected && !item.isCover}}" catchtap="setCoverPhoto" data-id="{{item.id}}">设封面</text>
            </view>
          </view>
          <view class="hint-box" wx:elif="{{photoLibraryLoading}}">正在加载照片库...</view>
          <view class="hint-box" wx:else>暂无可选照片，可先拍照上传。</view>
        </view>

        <view class="form-section last-section">
          <view class="section-row">
            <text class="form-section-title">关联学生</text>
            <text class="section-hint">{{selectedStudentIds.length}} 个已选</text>
          </view>
          <view class="student-grid" wx:if="{{studentRows.length > 0}}">
            <view class="student-chip {{item.selected ? 'selected' : ''}}" wx:for="{{studentRows}}" wx:key="id" data-id="{{item.id}}" bindtap="toggleStudent">
              <text class="student-name">{{item.name}}</text>
              <text class="student-grade" wx:if="{{item.grade}}">{{item.grade}}</text>
            </view>
          </view>
          <view class="hint-box" wx:else>暂无在读学生，请先添加学生。</view>
        </view>
      </scroll-view>

      <view class="meal-sheet-actions">
        <button class="sheet-btn cancel-btn" bindtap="closeForm">取消</button>
        <button class="sheet-btn save-btn" bindtap="submitMeal" loading="{{submitting}}" disabled="{{submitting}}">保存</button>
      </view>
    </view>
  </view>
</view>
