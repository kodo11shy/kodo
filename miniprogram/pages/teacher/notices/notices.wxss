.page { min-height: 100vh; background: #F7F8FC; padding-bottom: 40rpx; }

/* 状态卡 */
.overview-card {
  background: #5B7FFF;
  margin: 30rpx;
  border-radius: 20rpx;
  padding: 32rpx;
  color: #FFF;
}
.overview-head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24rpx; }
.overview-title { font-size: 34rpx; font-weight: bold; display: block; }
.overview-subtitle { font-size: 24rpx; opacity: 0.85; margin-top: 6rpx; display: block; }
.mini-action {
  background: rgba(255,255,255,0.25);
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
}
.metric-grid { display: flex; gap: 16rpx; }
.metric-item { flex: 1; text-align: center; }
.metric-value { font-size: 40rpx; font-weight: bold; display: block; }
.metric-label { font-size: 22rpx; opacity: 0.85; margin-top: 4rpx; display: block; }

/* 待处理卡 */
.todo-card {
  background: #FFF;
  margin: 0 30rpx 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.todo-head { display: flex; justify-content: space-between; margin-bottom: 16rpx; }
.todo-title { font-size: 28rpx; font-weight: bold; }
.todo-count { font-size: 24rpx; color: #FF6B35; }
.todo-row {
  display: flex; justify-content: space-between;
  padding: 16rpx 0;
  border-top: 2rpx solid #ECEFF5;
  font-size: 26rpx;
}
.todo-row:first-of-type { border-top: none; }
.todo-num { color: #5B7FFF; }

/* 筛选 */
.filter-scroll { white-space: nowrap; padding: 0 30rpx 20rpx; }
.filter-row { display: inline-flex; gap: 16rpx; }
.filter-chip {
  display: inline-flex; align-items: center; gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  background: #FFF;
  border: 2rpx solid #E8E8E8;
  color: #666;
}
.filter-chip.active {
  background: #5B7FFF;
  border-color: #5B7FFF;
  color: #FFF;
}
.filter-count {
  background: rgba(0,0,0,0.06);
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}
.filter-chip.active .filter-count {
  background: rgba(255,255,255,0.25);
}

/* 通知卡片 */
.notice-list { padding: 0 30rpx 30rpx; }
.notice-card {
  background: #FFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.notice-header { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx; }
.notice-title { font-size: 30rpx; font-weight: bold; flex: 1; }
.notice-type { font-size: 22rpx !important; }
.pin-tag { font-size: 22rpx !important; }
.notice-content {
  font-size: 28rpx;
  color: #555;
  margin-top: 12rpx;
  display: -webkit-box;
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  word-break: break-all;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}
.notice-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 16rpx; padding-top: 12rpx; border-top: 2rpx solid #ECEFF5; }
.notice-date { font-size: 22rpx; color: #BBB; }
.notice-actions { display: flex; gap: 20rpx; }
.action-edit { font-size: 24rpx; color: #5B7FFF; }
.action-delete { font-size: 24rpx; color: #E74C3C; }

/* 状态标签 */
.state-tag { font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 20rpx; }
.tag-ok { background: #E8F5E9; color: #2E7D32; }
.tag-warn { background: #FFF3E0; color: #E65100; }
.tag-danger { background: #FFEBEE; color: #C62828; }
.tag-muted { background: #F5F5F5; color: #999; }

/* 弹窗 */
.notice-sheet-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx 0;
  box-sizing: border-box;
  background: rgba(18, 24, 38, 0.58);
}

.notice-sheet {
  width: 88vw;
  max-width: 660rpx;
  max-height: 84vh;
  background: #FFFFFF;
  border-radius: 28rpx;
  overflow: hidden;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20rpx 60rpx rgba(16, 26, 52, 0.24);
}

.notice-sheet-head {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 30rpx 22rpx;
  border-bottom: 2rpx solid #EEF1F6;
}

.notice-sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2F3A4C;
}

.notice-sheet-close {
  width: 58rpx;
  height: 58rpx;
  line-height: 54rpx;
  text-align: center;
  border-radius: 50%;
  background: #F2F4F8;
  color: #697386;
  font-size: 40rpx;
}

.notice-sheet-body {
  max-height: calc(84vh - 190rpx);
  padding: 24rpx 30rpx 8rpx;
  box-sizing: border-box;
}

.notice-field {
  margin-bottom: 22rpx;
  min-width: 0;
}

.notice-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 25rpx;
  color: #6F788A;
}

.notice-control,
.notice-picker {
  width: 100%;
  box-sizing: border-box;
  border-radius: 14rpx;
  border: 2rpx solid #E5EAF2;
  background: #FFFFFF;
  color: #2F3A4C;
  font-size: 27rpx;
}

.notice-control {
  height: 76rpx;
  min-height: 76rpx;
  line-height: 76rpx;
  padding: 0 22rpx;
}

.notice-textarea {
  height: 180rpx;
  line-height: 1.5;
  padding: 18rpx 22rpx;
}

.notice-picker {
  min-height: 76rpx;
  line-height: 76rpx;
  padding: 0 22rpx;
}

.notice-row {
  display: flex;
  gap: 18rpx;
}

.notice-half {
  flex: 1;
  min-width: 0;
}

.notice-toggle {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.notice-toggle-hint {
  font-size: 25rpx;
  color: #7B8496;
}

.notice-clear-date {
  display: block;
  margin-top: 10rpx;
  text-align: right;
  font-size: 23rpx;
  color: #5B7FFF;
}

.notice-sheet-actions {
  flex-shrink: 0;
  display: flex;
  gap: 18rpx;
  padding: 20rpx 30rpx 26rpx;
  background: #FFFFFF;
  border-top: 2rpx solid #EEF1F6;
}

.notice-sheet-btn {
  flex: 1;
  height: 82rpx;
  line-height: 82rpx;
  padding: 0;
  border: none;
  border-radius: 18rpx;
  font-size: 29rpx;
  font-weight: 700;
}

.notice-sheet-btn.cancel {
  background: #F0F2F6;
  color: #697386;
}

.notice-sheet-btn.primary {
  background: #5B7FFF;
  color: #FFFFFF;
}

.notice-sheet-btn[disabled] {
  opacity: 0.6;
}
