<view class="page">
  <!-- 加载 -->
  <view class="loading-container" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <block wx:else>
    <!-- 标题 -->
    <view class="section-header">
      <text class="section-title">{{studentName}} 的作业</text>
    </view>

    <!-- 日期选择器 -->
    <view class="date-picker-bar">
      <view class="dp-btn {{selectedDate === '' ? 'active' : ''}}" bindtap="selectAll">📋 全部</view>
      <picker mode="date" value="{{selectedDate}}" bindchange="onDateChange">
        <view class="dp-btn {{selectedDate ? 'active' : ''}}">
          <text>{{selectedDate ? '📅 ' + selectedDate : '📅 选择日期'}}</text>
        </view>
      </picker>
    </view>

    <!-- 作业列表 -->
    <view class="hw-list" wx:if="{{records.length > 0}}">
      <view class="hw-card" wx:for="{{filteredList}}" wx:key="id">
        <view class="hw-header">
          <view class="hw-subject">
            <text class="subject-text">{{item.subject}}</text>
            <text class="hw-type tag tag-blue">{{item.homeworkTypeText}}</text>
          </view>
          <view class="hw-status tag {{item.statusClass}}">
            <text>{{item.statusIcon}} {{item.status}}</text>
          </view>
        </view>
        <text class="hw-date">{{item.date}}</text>

        <view class="hw-score" wx:if="{{item.score != null}}">
          <text class="score-label">评分</text>
          <text class="score-value">{{item.score}}/10</text>
          <text class="score-accuracy" wx:if="{{item.accuracy}}">· {{item.accuracy}}</text>
          <text class="score-errors" wx:if="{{item.error_count > 0}}">· 错{{item.error_count}}题</text>
        </view>

        <view class="hw-photos" wx:if="{{item.photos}}">
          <view class="photo-group" wx:if="{{item.photos.done && item.photos.done.length > 0}}">
            <text class="photo-step-label">📝 完成</text>
            <view class="photo-thumbs">
              <image class="thumb" wx:for="{{item.photos.done}}" wx:for-item="photo" wx:key="id" src="{{photo.url}}" mode="aspectFill" lazy-load bindtap="previewPhotos" data-list="{{item.photos.done}}" bindlongpress="saveHomeworkPhoto" data-src="{{photo.previewUrl}}" />
            </view>
          </view>
          <view class="photo-group" wx:if="{{item.photos.graded && item.photos.graded.length > 0}}">
            <text class="photo-step-label">✏️ 批改</text>
            <view class="photo-thumbs">
              <image class="thumb" wx:for="{{item.photos.graded}}" wx:for-item="photo" wx:key="id" src="{{photo.url}}" mode="aspectFill" lazy-load bindtap="previewPhotos" data-list="{{item.photos.graded}}" bindlongpress="saveHomeworkPhoto" data-src="{{photo.previewUrl}}" />
            </view>
          </view>
          <view class="photo-group" wx:if="{{item.photos.corrected && item.photos.corrected.length > 0}}">
            <text class="photo-step-label">✅ 改错</text>
            <view class="photo-thumbs">
              <image class="thumb" wx:for="{{item.photos.corrected}}" wx:for-item="photo" wx:key="id" src="{{photo.url}}" mode="aspectFill" lazy-load bindtap="previewPhotos" data-list="{{item.photos.corrected}}" bindlongpress="saveHomeworkPhoto" data-src="{{photo.previewUrl}}" />
            </view>
          </view>
        </view>

        <text class="hw-remark" wx:if="{{item.remark}}">{{item.remark}}</text>
      </view>

      <view class="empty-state" wx:if="{{filteredList.length === 0}}">
        <text wx:if="{{selectedDate}}">📭 {{selectedDate}} 没有作业</text>
      </view>
    </view>

    <!-- 空状态（全量无数据） -->
    <view class="empty-state" wx:elif="{{!loading}}">
      <image class="empty-image" src="/images/empty-homework-v2.png" mode="aspectFit"></image>
      <text>暂无作业记录</text>
      <text class="empty-desc">老师布置作业后，会出现在这里</text>
    </view>
  </block>
</view>
