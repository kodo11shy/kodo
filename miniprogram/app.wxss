/* ===== 全局样式 ===== */

/* 设计令牌 — 沉稳暖沙色系 */
page {
  --color-primary: #B8956A;
  --color-primary-dark: #A07850;
  --color-primary-light: #F0ECE6;
  --color-accent: #B8956A;
  --color-positive: #7A9A8A;
  --color-bg-teacher: #E8E3DC;
  --color-bg-parent: #F5F0EB;
  --color-text: #2A2622;
  --color-text-secondary: #8A8078;
  --color-text-muted: #B0A8A0;
  --color-border: #E0D8D0;
  --color-shadow: rgba(100, 90, 80, 0.08);

  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Noto Sans SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  color: var(--color-text);
  box-sizing: border-box;
}

/* 页面背景 */
.page-teacher { background-color: var(--color-bg-teacher); }
.page-parent { background-color: var(--color-bg-parent); }
.page-public { background-color: #FFF7EF; }

/* ===== 按钮 ===== */
.btn-primary {
  background-color: var(--color-primary);
  color: #FFFFFF;
  border: none;
  border-radius: 999rpx;
  padding: 22rpx 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  width: 100%;
  box-shadow: 0 10rpx 24rpx rgba(232, 131, 90, 0.20);
  transition: transform 0.15s ease;
}

.btn-primary:active {
  background-color: var(--color-primary-dark);
  transform: scale(0.97);
}

.btn-secondary {
  background-color: #FFFFFF;
  color: var(--color-text-secondary);
  border: 2rpx solid var(--color-border);
  border-radius: 999rpx;
  padding: 22rpx 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  width: 100%;
}

.btn-secondary:active {
  background-color: var(--color-bg-teacher);
}

.btn-danger {
  background-color: #FFF1EF;
  color: #D84A3A;
  border: 2rpx solid #FFDAD4;
  border-radius: 999rpx;
  padding: 22rpx 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  width: 100%;
}

/* 家长端主按钮 */
.btn-primary-parent {
  background-color: #FF8C5A;
  color: #FFFFFF;
  border: none;
  border-radius: 999rpx;
  padding: 22rpx 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  width: 100%;
  box-shadow: 0 10rpx 24rpx rgba(255, 140, 90, 0.20);
}

.btn-primary-parent:active {
  background-color: #E87A4A;
}

/* ===== 卡片 ===== */
.card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 20rpx 30rpx;
  box-shadow: 0 8rpx 32rpx var(--color-shadow);
}

/* ===== 标题 ===== */
.page-title {
  font-size: 36rpx;
  font-weight: bold;
  padding: 30rpx 30rpx 20rpx;
  color: var(--color-text);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: var(--color-text);
}

/* ===== 输入框 ===== */
.input-field {
  background-color: #FFFFFF;
  border-radius: 18rpx;
  padding: 24rpx 30rpx;
  font-size: 30rpx;
  border: 2rpx solid var(--color-border);
  width: 100%;
  box-sizing: border-box;
}

.input-field:focus {
  border-color: var(--color-primary);
}

/* ===== 标签 ===== */
.tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  margin: 6rpx;
}

.tag-blue {
  background-color: var(--color-primary-light);
  color: var(--color-primary);
}

.tag-green {
  background-color: #E7F8F3;
  color: var(--color-positive);
}

.tag-orange {
  background-color: #FFF1E8;
  color: #FF8C5A;
}

.tag-red {
  background-color: #FFF1EF;
  color: #D84A3A;
}

/* 加载 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 30rpx;
  color: #7B8496;
}

.empty-image {
  width: 260rpx;
  height: 260rpx;
  margin-bottom: 20rpx;
}

.empty-state text {
  margin-top: 16rpx;
  font-size: 28rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #B1B8C7;
  margin-top: 8rpx;
  max-width: 400rpx;
  text-align: center;
}

/* 全局模态框遮罩 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.4);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 100;
}
